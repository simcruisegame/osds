#!/bin/sh
# OSDS pre-push guardrail: a push that updates main must pass the fast tests.
# Installed by scripts/install-hooks.ps1. Only the Owner may skip it (git push --no-verify).
main_update=0
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then main_update=1; fi
done
[ "$main_update" = 1 ] || exit 0
echo "pre-push: updating main, running scripts\check.ps1 -Tier fast ..."
powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/check.ps1 -Tier fast
status=$?
if [ $status -ne 0 ]; then
  echo "pre-push: check.ps1 -Tier fast failed (exit $status); push to main refused." >&2
  exit 1
fi
